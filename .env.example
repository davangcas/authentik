# Copiar a .env y ajustar valores:
#   cp .env.example .env

# PostgreSQL — authentik-db (server y worker usan las mismas credenciales)
POSTGRES_USER=authentik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=authentik

# authentik-server y authentik-worker
# Generar clave: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=change-me-in-prod

# authentik-server — admin inicial (solo en el primer arranque)
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# authentik-server — dominio de cookies (sin protocolo ni puerto)
AUTHENTIK_COOKIE_DOMAIN=example.com
